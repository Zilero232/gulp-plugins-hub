{
  "name": "@zilero/gulp-refilename",
  "version": "1.0.4",
  "description": "Rename files in a gulp stream: a new name, a prefix or suffix, another extension or directory, or a function of the path parts.",
  "keywords": [
    "gulpplugin",
    "gulp",
    "gulp-plugin",
    "rename",
    "refilename",
    "filename",
    "extname",
    "dirname",
    "suffix",
    "prefix"
  ],
  "homepage": "https://zilero232.github.io/gulp-plugins-hub/plugins/refilename",
  "bugs": {
    "url": "https://github.com/Zilero232/gulp-plugins-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/gulp-plugins-hub.git",
    "directory": "packages/gulp-refilename"
  },
  "license": "MIT",
  "author": {
    "name": "Artemev Alexandr",
    "url": "https://github.com/Zilero232"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "@zilero/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/_tests"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zilero/gulp-plugin-factory": "workspace:^",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gulp-plugins-hub/tsdown-config": "workspace:*",
    "@gulp-plugins-hub/typescript-config": "workspace:*",
    "@gulp-plugins-hub/vitest-config": "workspace:*",
    "remeda": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
