{
  "name": "@zilero/gulp-file-concat",
  "version": "2.1.0",
  "description": "Concatenate the files of a gulp stream into one, with a separator, a header and a footer, and a source map pointing at every input.",
  "keywords": [
    "gulpplugin",
    "gulp",
    "gulp-plugin",
    "gulp-concat",
    "concat",
    "concatenate",
    "bundle",
    "join",
    "header",
    "footer",
    "banner",
    "sourcemaps"
  ],
  "homepage": "https://zilero232.github.io/gulp-plugins-hub/plugins/file-concat",
  "bugs": {
    "url": "https://github.com/Zilero232/gulp-plugins-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/gulp-plugins-hub.git",
    "directory": "packages/gulp-file-concat"
  },
  "license": "MIT",
  "author": {
    "name": "Artemev Alexandr",
    "url": "https://github.com/Zilero232"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "@zilero/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/_tests"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jridgewell/remapping": "^2.3.5",
    "@zilero/gulp-plugin-factory": "workspace:^",
    "magic-string": "^1.4.3",
    "picomatch": "^4.0.7",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gulp-plugins-hub/tsdown-config": "workspace:*",
    "@gulp-plugins-hub/typescript-config": "workspace:*",
    "@gulp-plugins-hub/vitest-config": "workspace:*",
    "@types/picomatch": "^4.0.3",
    "remeda": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
