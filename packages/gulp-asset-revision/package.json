{
  "name": "@zilero/gulp-asset-revision",
  "version": "0.0.0",
  "description": "Cache-busting for a gulp stream: add a content hash to asset names, rewrite the references in HTML, CSS and JavaScript, and write a manifest.",
  "keywords": [
    "gulpplugin",
    "gulp",
    "gulp-plugin",
    "rev",
    "revision",
    "hash",
    "fingerprint",
    "cache-busting",
    "manifest",
    "rewrite",
    "assets",
    "gulp-rev",
    "gulp-rev-rewrite",
    "gulp-rev-all",
    "gulp-rev-replace"
  ],
  "homepage": "https://zilero232.github.io/gulp-plugins-hub/plugins/asset-revision",
  "bugs": {
    "url": "https://github.com/Zilero232/gulp-plugins-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/gulp-plugins-hub.git",
    "directory": "packages/gulp-asset-revision"
  },
  "license": "MIT",
  "author": {
    "name": "Artemev Alexandr",
    "url": "https://github.com/Zilero232"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "@zilero/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/_tests"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zilero/gulp-plugin-factory": "workspace:^",
    "escape-string-regexp": "^5.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gulp-plugins-hub/tsdown-config": "workspace:*",
    "@gulp-plugins-hub/typescript-config": "workspace:*",
    "@gulp-plugins-hub/vitest-config": "workspace:*",
    "remeda": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
