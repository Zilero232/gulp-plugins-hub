{
  "name": "@zilero/gulp-file-changed",
  "version": "2.0.0",
  "description": "Pass only the files that changed since the last build, by modification time or contents, so watch builds skip the rest.",
  "keywords": [
    "gulpplugin",
    "gulp",
    "gulp-plugin",
    "gulp-changed",
    "gulp-newer",
    "changed",
    "newer",
    "incremental",
    "watch",
    "mtime",
    "cache",
    "skip"
  ],
  "homepage": "https://zilero232.github.io/gulp-plugins-hub/plugins/file-changed",
  "bugs": {
    "url": "https://github.com/Zilero232/gulp-plugins-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/gulp-plugins-hub.git",
    "directory": "packages/gulp-file-changed"
  },
  "license": "MIT",
  "author": {
    "name": "Artemev Alexandr",
    "url": "https://github.com/Zilero232"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "@zilero/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/_tests"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zilero/gulp-plugin-factory": "workspace:^",
    "tinyglobby": "^0.2.17",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gulp-plugins-hub/tsdown-config": "workspace:*",
    "@gulp-plugins-hub/typescript-config": "workspace:*",
    "@gulp-plugins-hub/vitest-config": "workspace:*",
    "@types/vinyl-fs": "^3.0.8",
    "remeda": "catalog:",
    "ts-pattern": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vinyl-fs": "^4.0.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
