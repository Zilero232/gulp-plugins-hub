{
  "name": "@zilero/gulp-font-switcher",
  "version": "2.1.0",
  "description": "Convert fonts in a gulp stream to woff2, woff, ttf, eot or SVG and subset them to the glyphs you use, keeping every OpenType feature.",
  "keywords": [
    "gulpplugin",
    "gulp",
    "gulp-plugin",
    "font",
    "fonts",
    "webfont",
    "ttf",
    "otf",
    "woff",
    "woff2",
    "eot",
    "svg",
    "subset",
    "harfbuzz",
    "gulp-ttf2woff2",
    "gulp-ttf2woff",
    "gulp-fontmin",
    "gulp-subset-font"
  ],
  "homepage": "https://zilero232.github.io/gulp-plugins-hub/plugins/font-switcher",
  "bugs": {
    "url": "https://github.com/Zilero232/gulp-plugins-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/gulp-plugins-hub.git",
    "directory": "packages/gulp-font-switcher"
  },
  "license": "MIT",
  "author": {
    "name": "Artemev Alexandr",
    "url": "https://github.com/Zilero232"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "@zilero/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/_tests"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zilero/gulp-plugin-factory": "workspace:^",
    "fonteditor-core": "^2.6.3",
    "fontverter": "^2.0.0",
    "subset-font": "^2.9.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gulp-plugins-hub/tsdown-config": "workspace:*",
    "@gulp-plugins-hub/typescript-config": "workspace:*",
    "@gulp-plugins-hub/vitest-config": "workspace:*",
    "remeda": "catalog:",
    "ts-pattern": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
