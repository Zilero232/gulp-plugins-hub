{
  "name": "@zilero/gulp-pug-compiler",
  "version": "2.0.0",
  "description": "Compile Pug templates to HTML in a gulp stream, with per-file data, includes from the file contents and your own extension.",
  "keywords": [
    "gulpplugin",
    "gulp",
    "gulp-plugin",
    "pug",
    "jade",
    "template",
    "templates",
    "html",
    "compile"
  ],
  "homepage": "https://zilero232.github.io/gulp-plugins-hub/plugins/pug-compiler",
  "bugs": {
    "url": "https://github.com/Zilero232/gulp-plugins-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/gulp-plugins-hub.git",
    "directory": "packages/gulp-pug-compiler"
  },
  "license": "MIT",
  "author": {
    "name": "Artemev Alexandr",
    "url": "https://github.com/Zilero232"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "@zilero/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/_tests"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/pug": "^2.0.10",
    "@zilero/gulp-plugin-factory": "workspace:^",
    "pug": "^3.0.4",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gulp-plugins-hub/tsdown-config": "workspace:*",
    "@gulp-plugins-hub/typescript-config": "workspace:*",
    "@gulp-plugins-hub/vitest-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
