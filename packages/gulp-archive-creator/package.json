{
  "name": "@zilero/gulp-archive-creator",
  "version": "2.0.0",
  "description": "Pack the files of a gulp stream into one zip, tar or tar.gz archive.",
  "keywords": [
    "gulpplugin",
    "gulp",
    "gulp-plugin",
    "archive",
    "zip",
    "tar",
    "tgz",
    "gzip",
    "archiver",
    "compress",
    "gulp-zip",
    "gulp-tar",
    "gulp-gzip",
    "gulp-vinyl-zip"
  ],
  "homepage": "https://zilero232.github.io/gulp-plugins-hub/plugins/archive-creator",
  "bugs": {
    "url": "https://github.com/Zilero232/gulp-plugins-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/gulp-plugins-hub.git",
    "directory": "packages/gulp-archive-creator"
  },
  "license": "MIT",
  "author": {
    "name": "Artemev Alexandr",
    "url": "https://github.com/Zilero232"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "@zilero/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/_tests"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/archiver": "^8.0.0",
    "@zilero/gulp-plugin-factory": "workspace:^",
    "archiver": "^8.0.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gulp-plugins-hub/tsdown-config": "workspace:*",
    "@gulp-plugins-hub/typescript-config": "workspace:*",
    "@gulp-plugins-hub/vitest-config": "workspace:*",
    "ts-pattern": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
