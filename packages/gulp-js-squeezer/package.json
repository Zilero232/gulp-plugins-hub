{
  "name": "@zilero/gulp-js-squeezer",
  "version": "2.0.0",
  "description": "Minify JavaScript in a gulp stream with terser, keeping source maps.",
  "keywords": [
    "gulpplugin",
    "gulp",
    "gulp-plugin",
    "javascript",
    "js",
    "minify",
    "uglify",
    "terser",
    "sourcemaps",
    "compress"
  ],
  "homepage": "https://zilero232.github.io/gulp-plugins-hub/plugins/js-squeezer",
  "bugs": {
    "url": "https://github.com/Zilero232/gulp-plugins-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/gulp-plugins-hub.git",
    "directory": "packages/gulp-js-squeezer"
  },
  "license": "MIT",
  "author": {
    "name": "Artemev Alexandr",
    "url": "https://github.com/Zilero232"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "@zilero/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!src/**/_tests"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run --configLoader runner",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@zilero/gulp-plugin-factory": "workspace:^",
    "terser": "^5.51.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@gulp-plugins-hub/tsdown-config": "workspace:*",
    "@gulp-plugins-hub/typescript-config": "workspace:*",
    "@gulp-plugins-hub/vitest-config": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
