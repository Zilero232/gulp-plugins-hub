    "GSUB",
    "gulpfile",
    "gulpfiles",
    "gulpplugin",
    "harfbuzz",
    "hmtx",
    "horiz",
    "jridgewell",
    "jsquash",
    "Kahn",
    "lightningcss",
    "llms",
    "loca",
    "minfy",
    "minifiers",
    "mozjpeg",
    "nocase",
    "nodir",
    "oklch",
    "qualty",
    "sfnt",
    "siberiacancode",
    "stemm",
    "subsetting",
