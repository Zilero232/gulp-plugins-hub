{
  "name": "gulp-plugins-hub",
  "version": "0.0.0",
  "private": true,
  "description": "Typed Gulp 5 plugins for HTML, Pug, SCSS, JavaScript, fonts, archives and file routing, plus the factory they are built with.",
  "homepage": "https://zilero232.github.io/gulp-plugins-hub/",
  "bugs": {
    "url": "https://github.com/Zilero232/gulp-plugins-hub/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zilero232/gulp-plugins-hub.git"
  },
  "license": "MIT",
  "author": {
    "name": "Artemev Alexandr",
    "url": "https://github.com/Zilero232"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tooling/*"
    ],
    "catalog": {
      "@types/node": "^22.19.0",
      "@types/vinyl": "^2.0.12",
      "gulp": "^5.0.1",
      "plugin-error": "^2.0.1",
      "remeda": "^2.52.0",
      "ts-pattern": "^5.9.2",
      "tsdown": "^0.23.1",
      "typescript": "~6.0.3",
      "vinyl": "^3.0.1",
      "zod": "^4.6.7"
    }
  },
  "scripts": {
    "build": "turbo run build --filter=./packages/*",
    "changeset": "changeset",
    "clean": "rm -rf packages/*/dist apps/example/dist apps/example/release apps/docs/.vitepress/dist apps/docs/.vitepress/cache .turbo packages/*/.turbo apps/*/.turbo tooling/*/.turbo coverage .pack .eslintcache .cspellcache",
    "commit": "jazzer",
    "dev": "turbo run dev --filter=./packages/*",
    "docs:build": "turbo run build --filter=gulp-plugins-hub-docs",
    "docs:dev": "bun run --filter gulp-plugins-hub-docs dev",
    "example": "turbo run build --filter=gulp-plugins-hub-example",
    "fix": "eslint . --fix && prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "prepare": "husky",
    "release": "bun run build && bun scripts/publish/index.ts",
    "test": "turbo run test && vitest run --configLoader runner --project scripts",
    "test:coverage": "vitest run --configLoader runner --coverage",
    "test:watch": "vitest --configLoader runner",
    "typecheck": "turbo run typecheck && tsc --noEmit",
    "verify": "bun run typecheck && bun run lint && bun run format:check",
    "version": "changeset version && bun install --lockfile-only"
  },
  "lint-staged": {
    "*.{json,md,yml,yaml}": "prettier --write",
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@gulp-plugins-hub/typescript-config": "workspace:*",
    "@siberiacancode/eslint": "^2.18.1",
    "@siberiacancode/prettier": "^1.9.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "^5.0.5",
    "commit-jazzer": "^2.0.1",
    "eslint": "^10.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-packagejson": "^3.0.2",
    "turbo": "^2.11.9",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22.18.0"
  }
}
