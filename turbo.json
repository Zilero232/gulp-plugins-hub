{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  // The shared configs are workspaces (tooling/*), so their changes reach dependents through the task graph.
  "globalDependencies": ["mise.toml"],
  "tasks": {
    // Workspaces import each other's sources (the "@zilero/source" export condition), so typecheck and tests
    // need no build; `transit` still makes a dependency change invalidate its dependents' caches.
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/_tests/**", "!README.md", "!CHANGELOG.md"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "!README.md", "!CHANGELOG.md"]
    },
    // The example runs gulp on the built packages, as a user would: it needs their dist/ first. NODE_ENV switches
    // it to production and ANALYTICS_ID fills in the vendor script, so both are part of the cache key.
    "gulp-plugins-hub-example#build": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV", "ANALYTICS_ID"],
      "outputs": ["dist/**"]
    },
    "gulp-plugins-hub-docs#build": {
      "outputs": [".vitepress/dist/**"]
    },
    "gulp-plugins-hub-example#test": {
      "dependsOn": ["^build"],
      "env": ["NODE_ENV", "ANALYTICS_ID"],
      "outputs": ["dist/**", "release/**"]
    }
  }
}
